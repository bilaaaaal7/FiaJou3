# Paramètres SMTP pour l'envoi d'emails (réinitialisation de mot de passe, etc.)
# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Exemple avec Gmail : générez un "mot de passe d'application" sur myaccount.google.com/apppasswords
# Exemple avec Mailtrap (tests, aucun vrai email envoyé) : mailtrap.io

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=elbbilal00email@gmail.com
MAIL_PASSWORD=cpmmhkolzrsolbzf
MAIL_FROM_ADDRESS="elbbilal00email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
# Durée de validité (en secondes) d'un lien de réinitialisation de mot de passe
RESET_PASSWORD_EXPIRY=3600
