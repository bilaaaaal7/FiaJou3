# Copier ce fichier en ".env" (même dossier) puis renseigner les vraies
# valeurs. ".env" ne doit JAMAIS être commité dans Git (voir .gitignore).

# Identifiants OAuth 2.0 Google (Google Cloud Console > API et services >
# Identifiants > ID client OAuth). Voir README_google_oauth.md pour la
# procédure complète pas à pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URI de callback exacte, déclarée dans Google Cloud Console sous
# "URI de redirection autorisés". Doit correspondre AU CARACTÈRE PRÈS
# (schéma, hôte, port, chemin) à l'URL réellement utilisée par le serveur.
#
# Exemple local (XAMPP/WAMP, projet servi depuis http://localhost/FiaJou3) :
GOOGLE_REDIRECT_URI=http://localhost/FiaJou3/index.php?route=auth/google/callback
